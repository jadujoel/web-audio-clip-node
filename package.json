{
	"name": "@jadujoel/web-audio-clip-node",
	"version": "0.2.12",
	"type": "module",
	"description": "Full-featured AudioWorklet clip player with playback rate, detune, gain, pan, filters, looping, fades, crossfade, and streaming buffer support. React components included.",
	"keywords": [
		"web-audio",
		"audioworklet",
		"audio",
		"clip",
		"player",
		"dsp",
		"react",
		"worklet"
	],
	"author": "joel.lof@icloud.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jadujoel/web-audio-clip-node.git"
	},
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"import": "./dist/lib.js"
		},
		"./bundle": "./dist/lib.bundle.js",
		"./react": {
			"types": "./dist/lib-react.d.ts",
			"import": "./dist/lib-react.js"
		},
		"./streaming": {
			"types": "./dist/streaming.d.ts",
			"import": "./dist/streaming.js"
		},
		"./processor": "./dist/clip-processor.bundle.js",
		"./styles.css": {
			"types": "./dist/styles.css.d.ts",
			"default": "./dist/styles.css"
		}
	},
	"main": "./dist/lib.bundle.js",
	"types": "./dist/lib.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"examples"
	],
	"sideEffects": [
		"./src/polyfills.ts",
		"./dist/polyfills.js"
	],
	"scripts": {
		"build": "bun build.ts",
		"build:lib": "bun build.ts --lib",
		"build:webpage": "bun build.ts --webpage",
		"dev": "bun serve-webpage.ts",
		"examples": "bun examples.ts",
		"lint": "biome check",
		"serve-webpage": "bun serve-webpage.ts",
		"test": "vitest run",
		"test:bun": "bun test build.test.ts test-runner-config.test.ts src/examplesConfig.test.ts src/streaming.test.ts",
		"test:all": "vitest run && bun run test:bun",
		"test:e2e": "bunx playwright test",
		"test:e2e:chromium": "bunx playwright test --project=chromium",
		"test:e2e:firefox": "bunx playwright test --project=firefox",
		"test:e2e:webkit": "bunx playwright test --project=webkit",
		"smoke:legacy": "bun smoke-legacy.ts",
		"typecheck": "tsc --noEmit",
		"validate": "bun run build && bun run lint && bun run typecheck && bun run test:all",
		"prepublishOnly": "bun run build:lib"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"zustand": ">=4"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"zustand": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@playwright/test": "1.59.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"@vitest/browser-playwright": "4.1.4",
		"bun-types": "1.3.12",
		"libav.js": "6.8.8",
		"libavjs-webcodecs-polyfill": "0.5.5",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"vitest": "4.1.4",
		"webdriverio": "9.27.0",
		"zustand": "5.0.12"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@jadujoel/typed-event-target": "0.0.6",
		"neverthrow": "8.2.0",
		"web-audio-beat-detector": "8.2.36"
	}
}
