{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": false
	},
	"include": ["src"],
	"exclude": [
		"src/**/*.test.*",
		"src/index.html",
		"src/index.tsx",
		"src/App.tsx",
		"src/App.test.tsx"
	]
}
