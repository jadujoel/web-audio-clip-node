{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "types": ["bun-types"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@jadujoel/web-audio-clip-node": ["../../src/lib"],
      "@jadujoel/web-audio-clip-node/react": ["../../src/lib-react"],
      "@jadujoel/web-audio-clip-node/styles.css": ["../../src/styles.css"]
    }
  },
  "include": ["src/**/*", "*.ts", "generated/**/*"]
}
